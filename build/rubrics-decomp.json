{
  "note": "反编译能力评分表。每道题的汇编都有唯一的标准答案，所以「说得对不对」可以逐条判。特别设计了两类陷阱：第 2 题（5 条指令不足以唯一归因，敢下死结论就是装懂）和第 4 题（编译器 idiom，必须解释那条多出来的指令）。",
  "prompts": [
    {
      "id": "ppc-loop",
      "title": "PowerPC：计数循环",
      "must_mention": [
        { "name": "识别为计数循环/自增循环", "patterns": ["计数", "循环", "loop", "自增", "递增", "迭代"] },
        { "name": "语义是 max(0, x)（x≤0 返回 0，否则返回 x）", "patterns": ["max\\s*\\(", "至少.{0,4}0", "非负", "clamp", "(r3|x).{0,20}(<=|≤|<) ?0", "(<=|≤|<) ?0.{0,30}(返回|return|结果)"] },
        { "name": "ABI：r3 既传参又回传结果", "patterns": ["r3.{0,25}(参数|实参|入参|返回值|argument|return)", "(参数|argument).{0,15}r3", "r3.{0,10}传到.{0,10}r3"] },
        { "name": "mflr/mtlr 保存与恢复链接寄存器 LR", "patterns": ["mflr", "mtlr", "链接寄存器", "link register"] },
        { "name": "识别出栈帧（stwu r1,-16 建立，结尾 addi r1,r1,16 撤销）", "patterns": ["stwu", "栈帧", "stack frame", "16 ?(字节|bytes)"] }
      ],
      "suspect": [
        { "name": "说它在保存 r31（本段根本没碰 r31）", "patterns": ["保存.{0,10}r31", "r31.{0,15}(恢复|restore)"] },
        { "name": "把 PowerPC 认成 MIPS（mflr/mtlr/stwu/lwz/blr 是 PowerPC 专有）", "patterns": ["MIPS"] },
        { "name": "说返回值在 r0（PowerPC 返回值在 r3；r0 只是 mflr/mtlr 的中转）", "patterns": ["r0.{0,30}(返回|return)", "返回(值)?.{0,20}(通过|在|存(在|入)) ?`?r0"] }
      ]
    },
    {
      "id": "x86-mix",
      "title": "x86-64：黄金比例乘法混合（归因陷阱）",
      "must_mention": [
        { "name": "认出常量 2654435761 = 0x9E3779B9（2³²/φ，Knuth 黄金比例）", "patterns": ["9[eE]3779[bB]9", "2654435761", "黄金比", "golden ratio", "Knuth"] },
        { "name": "ABI：edi 第一参数、edx 第二参数、eax 返回值", "patterns": ["edi.{0,35}(第一|1 ?st|参数)", "edx.{0,35}(第二|2 ?nd|参数)", "第一.{0,15}参数.{0,25}edi"] },
        { "name": "rol 13 = 循环左移 13 位", "patterns": ["rol.{0,15}13", "(循环)?左(移|旋).{0,8}13", "rotate left.{0,10}13"] },
        { "name": "不下死结论：几条指令不足以唯一归因到某个算法", "patterns": ["无法(唯一)?(确定|判断|归因|断定)", "证据不足", "不足以", "不能唯一", "仅凭.{0,30}(无法|不能|不足)", "可能是", "疑似", "不确定", "无法确定", "多种可能", "属于.{0,12}某(一)?(种|类)", "not enough", "insufficient"] }
      ],
      "suspect": [
        { "name": "编造 mix32 的『标准实现』来硬套", "patterns": ["mix32", "static inline uint32_t mix"] },
        { "name": "斩钉截铁断言就是 MurmurHash3（未加任何限定）", "patterns": ["就是 ?\\*{0,2}MurmurHash3", "属于 ?\\*{0,2}MurmurHash3", "是 MurmurHash3"] },
        { "name": "引用 fmix32 但常量不对（真值是 0x85ebca6b / 0xc2b2ae35）", "patterns": ["fmix32(?![\\s\\S]{0,400}(85[eE][bB][cC][aA]6[bB]|c2[bB]2[aA][eE]35))"] }
      ]
    },
    {
      "id": "arm64-strlen",
      "title": "ARM64：strlen",
      "must_mention": [
        { "name": "识别为 strlen / 求字符串长度", "patterns": ["strlen", "字符串长度", "string length", "求长度", "长度"] },
        { "name": "说明 [x1], #1 是后自增寻址（先取后加）", "patterns": ["后(自)?增", "post-?increment", "\\[x1\\], ?#1", "先(取值|读|访问).{0,15}(再|然后).{0,10}(加|自增)"] },
        { "name": "说明结尾 0 被多算了一次，所以要再减 1", "patterns": ["\\\\0", "NUL", "结尾.{0,25}(多|越|跳|算)", "多(算|计|走|加).{0,8}(1|一)", "越过.{0,12}(1|一)", "再 ?减 ?1", "减去.{0,12}(1|一)", "- ?1.{0,25}(结尾|NUL|\\\\0|多)"] },
        { "name": "ABI：x0 既传参又回传结果", "patterns": ["x0.{0,25}(参数|实参|返回值)", "返回值.{0,12}x0"] },
        { "name": "cbnz = 非零则跳转", "patterns": ["cbnz", "非零.{0,12}(跳|分支)", "不为零", "比较.{0,10}(并)?.{0,10}(非零)?跳转"] }
      ],
      "suspect": []
    },
    {
      "id": "x86-div2",
      "title": "x86-64：有符号除法 idiom（编译器生成）",
      "must_mention": [
        { "name": "结论：原始的 C 表达式是 x / 2（有符号除法）", "patterns": ["除以 ?2", "/ ?2", "除以二", "division by 2", "除 ?2", "/2"] },
        { "name": "解释 shr eax,31 是把符号位取出来（负数时为 1）", "patterns": ["shr.{0,15}31", ">> ?31", "符号位.{0,25}(取|拿|得|1)", "sh[rl].{0,20}31"] },
        { "name": "解释 add 那一步是对负数补 1 的偏置修正", "patterns": ["负数.{0,30}(加|修正|\\+ ?1|补|偏置|bias)", "(加|补).{0,15}1.{0,25}负数", "修正", "偏置", "bias", "对负数.{0,10}\\+ ?1"] },
        { "name": "说明 sar 是向下取整，直接 sar 会得到 floor 而非向零截断", "patterns": ["(向下|floor|往小).{0,30}(取整|舍入|舍|round)", "sar.{0,35}(向下|floor)", "(截断|向零|trunc).{0,30}(取整|舍|toward|行)", "-1 ?/ ?2", "0\\.5"] },
        { "name": "指出这是编译器为 x/2 生成的，不是简单的 x>>1 等价", "patterns": ["编译器", "compiler", "优化", "optimi[sz]", "不等价", "不是.{0,15}(简单|普通|单纯的)?(算术)?右移", "不能(简单)?用.{0,10}>>"] }
      ],
      "suspect": [
        { "name": "把它解释成无符号或普通右移 / 说是取绝对值", "patterns": ["取绝对值", "abs\\(", "无符号右移", "逻辑右移"] }
      ]
    },
    {
      "id": "x86-mul",
      "title": "x86-64：重复加法实现乘法",
      "must_mention": [
        { "name": "结论：返回 n * m", "patterns": ["n ?\\* ?m", "乘法", "multipl", "重复加", "repeated addition", "乘.{0,10}累加", "累加.{0,10}乘"] },
        { "name": "识别 esi 是循环计数、edx 是每次累加的量", "patterns": ["esi.{0,40}(计数|循环|次数|n\\b)", "edx.{0,40}(加数|增量|乘数|m\\b)"] },
        { "name": "指出第一个参数 edi 根本没被用到", "patterns": ["edi.{0,50}(没用|未使用|未用|忽略|不(用|使用|被使用)|unused|not used|没有使用|闲置)"] },
        { "name": "n ≤ 0 时直接返回 0", "patterns": ["(n|esi).{0,25}(<=|≤|小于等于).{0,15}0", "(<=|≤) ?0.{0,30}(返回|return) ?0", "(非正|负|0).{0,30}(返回|return) ?0", "jle"] }
      ],
      "suspect": [
        { "name": "把 edi 说成参与运算了", "patterns": ["edi.{0,25}(作为|是).{0,15}(被乘数|第一个参数.{0,10}(参与|用))"] }
      ]
    }
  ]
}
